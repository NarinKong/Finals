    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: '<b>House 3: Convenience Shop (0/10)</b>

    <color=#FFCC44>[TODO]</color>
    1. [UI] Press Start Shopping on Cash Register

    <color=#FFCC44>[TODO]</color>
    2. [UI] Add Bottle Price (+$2.50) on Register

    <color=#FFCC44>[TODO]</color>
    3. [SCRIPT] Swing Fridge Doors open

    <color=#FFCC44>[TODO]</color> 4. [GRAB]
    Grab Bottle from Fridge into Basket

    <color=#FFCC44>[TODO]</color> 5. [UI]
    Add Chips (+$1.99) / Leek (+$1.50) Price

    <color=#FFCC44>[TODO]</color> 6.
    [GRAB] Grab Chips from Shelf into Basket

    <color=#FFCC44>[TODO]</color> 7.
    [GRAB] Grab Leek from Shelf into Basket

    <color=#FFCC44>[TODO]</color> 8.
    [GRAB] Place full Basket onto Checkout Table

    <color=#FFCC44>[TODO]</color>
    9. [UI] Press Pay & Confirm on Cash Register

    <color=#FFCC44>[TODO]</color>
    10. [SCRIPT] Automatic Sliding Door via proximity

'
